  <w:comment w:id="2" w:author="Matthias Däniker" w:date="2026-07-02T12:03:00Z" w:initials="MD">
    <w:p w14:paraId="7397486E" w14:textId="1A6CC50D" w:rsidR="00170DF4" w:rsidRDefault="00170DF4">
      <w:r>
        <w:annotationRef/>
      </w:r>
      <w:r w:rsidRPr="25A8452B">
        <w:t>Find ich auch, das haben wir ja am Dienstag so besprochen. Wer sich daran stört, kann es ja wieder raus löschen</w:t>
      </w:r>
    </w:p>

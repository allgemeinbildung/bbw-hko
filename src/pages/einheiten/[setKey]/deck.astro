---
import { loadEinheit, einheitById, isEntwurf } from '../../../lib/einheiten'
import { guestGateHtml } from '../../../lib/einheiten/guest-gate'
import { buildStandaloneDeckHtml, deckSourceFromFullSet } from '../../../lib/einheiten/deck-builder'
import { buildStandaloneDeckHtmlV42, deckSourceV42, istV42Einheit } from '../../../lib/einheiten/deck-v42'
import { SPUR_KEYS } from '../../../lib/einheiten/spuren'
import type { SpurKey } from '../../../lib/einheiten/types'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')

const setKey = Astro.params.setKey!
const meta = einheitById(setKey)
const fullSet = loadEinheit(setKey)

if (!meta || !fullSet) {
  return new Response('Einheit nicht gefunden', { status: 404 })
}

// Das Deck ist Lehrpersonen-Material (es zeigt Tafelbilder und Coaching-Hinweise in den
// Notizen) — Gäste bekommen dieselbe Gate-Seite wie beim Begleitdokument.
const { data: gateProfile } = await Astro.locals.supabase
  .from('profiles')
  .select('role')
  .eq('id', user.id)
  .single()
if (gateProfile?.role === 'gast') {
  return new Response(guestGateHtml(setKey, 'Unterrichtsdeck «Präsentation»'), {
    status: 403,
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  })
}

// Entwurf-Einheiten sind nur für KT1 sichtbar. Die Detailseite leitet lp/gast bereits
// um — diese Unterroute wird aber direkt per URL erreicht und muss dieselbe Schranke
// selbst ziehen, sonst liesse sich ein unveröffentlichtes Deck am Katalog vorbei öffnen.
if (isEntwurf(meta) && gateProfile?.role !== 'kt1') {
  return Astro.redirect('/einheiten')
}

// v4.2 (E29): je Spur eine Fassung. `?spur=ohne_medien|mit_medien` wählt sie; ohne Angabe
// oder bei einem unbekannten Wert gilt die Spur, in der `loadEinheit` aufgelöst hat
// (`set.spur`, sonst `DEFAULT_SPUR`). Einheiten ohne Spuren laufen unten wie bisher.
if (istV42Einheit(fullSet)) {
  const wunsch = Astro.url.searchParams.get('spur')
  const spur = (SPUR_KEYS as readonly string[]).includes(wunsch ?? '') ? (wunsch as SpurKey) : undefined
  const srcV42 = deckSourceV42(fullSet, spur)
  if (!srcV42) {
    return new Response(
      'Für diese Einheit gibt es noch kein Unterrichtsdeck — es fehlen Bausteine (Prinzip, KN oder Hefte).',
      { status: 404 }
    )
  }
  // Die Spur gehört zur Kennung: zwei offene Fassungen sollen sich nicht gegenseitig steuern.
  return new Response(buildStandaloneDeckHtmlV42(srcV42, `${setKey}-${srcV42.spur}`), {
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  })
}

const src = deckSourceFromFullSet(fullSet)
if (!src) {
  return new Response(
    'Für diese Einheit gibt es noch kein Unterrichtsdeck — es fehlen Bausteine (Prinzip, KN, Begleiter oder Herausforderungen).',
    { status: 404 }
  )
}

const html = buildStandaloneDeckHtml(src, setKey)
return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8' } })
---

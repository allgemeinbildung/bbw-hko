---
import Einheiten from '../../layouts/Einheiten.astro'
import EinheitWorkbench from '../../components/einheiten/EinheitWorkbench.tsx'
import { einheitById, loadEinheit, ABTEILUNGEN, isEntwurf, isArchiviert, istNurKt1, draftKomponenten, stripDraftComponents, KOMPONENTEN_LABEL, lehrgaengeOf, lehrgangLabel } from '../../lib/einheiten'
import { enrichKompetenzen } from '../../lib/einheiten/kompetenz-text'
import { knTypLabel } from '../../lib/einheiten/kn-typ-labels'
import { ladeErfahrungen } from '../../lib/erfahrungen'
import Erfahrungen from '../../components/einheiten/Erfahrungen.astro'
import { skNameByNr, skTooltip } from '../../lib/sk-labels'
import cssRendererBasis from '../../styles/einheiten-renderer.css?raw'
import { cssFuerEinheit } from '../../lib/einheiten/css-v42'
import cssBegleiter from '../../styles/einheiten-begleiter.css?raw'
import type { EinheitFullSet } from '../../lib/einheiten/types'
import { darfForken, istV42Einheit } from '../../lib/fork/positivliste'
import { zuFassungSicht, waehleModus, ersetzungenFuer, fassungPruefer, nurSpurFuer, bausteineUnpassend, baueForkProp, type BuendelZeile } from '../../lib/fork/seite'
import type { FassungBericht, FassungSicht, ForkProp } from '../../lib/fork/typen'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')

const { data: profile } = await Astro.locals.supabase
  .from('profiles')
  .select('role, abteilung')
  .eq('id', user.id)
  .single()

const role: 'lp' | 'kt1' | 'gast' =
  profile?.role === 'kt1' ? 'kt1' : profile?.role === 'gast' ? 'gast' : 'lp'
const isGuest = role === 'gast'

// Abteilung aus dem Profil auf eine Workbench-Option mappen (umlaut-insensitiv, damit
// «Technik | Ernährung» aus dem Profil auf «Abteilung Technik | Ernährung» matcht).
const normAbt = (s: string) =>
  s.toLowerCase().replace(/abteilung/g, '').replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/[^a-z0-9]/g, '')
const defaultAbteilung =
  ABTEILUNGEN.find((o) => o && profile?.abteilung && normAbt(o) === normAbt(profile.abteilung)) ?? ''

const setKey = Astro.params.setKey!
const meta = einheitById(setKey)
const fullSet = loadEinheit(setKey)
if (!meta || !fullSet) {
  return new Response('Einheit nicht gefunden', { status: 404 })
}
// Heft v4.2: dessen CSS kommt nur dazu, wenn die Einheit Spuren hat — sonst bleibt
// der String (Vorschau wie Download) Zeichen für Zeichen der bisherige.
const cssRenderer = cssFuerEinheit(cssRendererBasis, fullSet)

// Sichtbarkeit: ganze Entwurf-Einheiten und archivierte Einheiten sind für lp/gast
// nicht direkt aufrufbar.
if (istNurKt1(meta) && role !== 'kt1') {
  return Astro.redirect('/einheiten')
}
// Fork-Pilot «Meine Fassung» (Invarianten 3, 11, 12): nur kt1 und nur v4.2. Sonst bleibt
// `forkProp` null und alles Folgende läuft wie ohne Pilot — dasselbe Set, keine Prop.
let forkProp: ForkProp | null = null
let anzeigeSet: EinheitFullSet = fullSet
if (darfForken(role) && istV42Einheit({ A: fullSet.hf_A, B: fullSet.hf_B })) {
  // Eigene Zeilen über RLS; kt1 darf alle lesen, darum ausdrücklich user_id. Fehlt die
  // Migration oder schlägt etwas fehl: als gäbe es keine Fassung (Muster jahresplanung.astro).
  let sicht: FassungSicht | null = null
  try {
    const { data: f, error: fe } = await Astro.locals.supabase
      .from('einheit_fassungen').select('id, nur_spur, ersetzungen')
      .eq('user_id', user.id).eq('einheit_id', setKey).maybeSingle()
    if (!fe && f) {
      const { data: b, error: be } = await Astro.locals.supabase
        .from('einheit_fassung_buendel')
        .select('id, heft, status, kommentare, vorschlag, entscheide, text_pfad, created_at')
        .eq('fassung_id', f.id).eq('user_id', user.id).order('created_at', { ascending: true })
      sicht = zuFassungSicht(setKey, f, be ? [] : ((b ?? []) as BuendelZeile[]))
    }
  } catch {
    sicht = null
  }
  const q = Astro.url.searchParams
  const { modus, buendel } = waehleModus(sicht, q.get('ansicht'), q.get('vorschau'))
  const ersetzungen = sicht ? ersetzungenFuer(sicht, modus, buendel) : { fassung: [], vorschlag: [] }
  let bericht: FassungBericht | null = null
  if (sicht && modus !== 'original') {
    const nurSpur = nurSpurFuer(sicht, ersetzungen.vorschlag)
    const mitFassung = loadEinheit(setKey, {
      fassung: { ersetzungen: [...ersetzungen.fassung, ...ersetzungen.vorschlag], ...(nurSpur ? { nur_spur: nurSpur } : {}) },
      fassungPruefer,
    })
    if (mitFassung) {
      const { fassung_bericht, ...rest } = mitFassung
      bericht = fassung_bericht ?? null
      anzeigeSet = rest
    }
  }
  forkProp = baueForkProp({ einheitId: setKey, eba: meta.lehrgang === 'EBA_2J', sicht, modus, buendel, ersetzungen, bericht })
  // VERTRAG §5: Bei Situations- oder Textwechsel passen Begleiter und KI-Toolbox nicht
  // mehr — sie fehlen in Vorschau und ZIP der Fassung. KN bleibt (mit Warnung).
  if (modus !== 'original' && bausteineUnpassend(forkProp.warnungen)) {
    anzeigeSet = { ...anzeigeSet, ki: null, lernprompt: null, lernbegleiter: null, kiLiesmich: null, begleiter: null }
  }
}
const forkAnsicht = forkProp && forkProp.modus !== 'original' ? forkProp : null
const zeigeUmschalter = !!forkProp && (forkProp.fassung?.ersetzungen.length ?? 0) > 0
const forkUrl = (ansicht: 'original' | 'fassung') => `/einheiten/${setKey}?ansicht=${ansicht}`

// Entwurf-Bausteine (z. B. KI-Toolbox) für lp/gast aus dem Set entfernen, bevor
// es ans Workbench-Island geht — KI-Tab + KI-Dateien im ZIP verschwinden.
const visibleSet = stripDraftComponents(anzeigeSet, meta, role)
const draftKomps = role === 'kt1' ? draftKomponenten(meta) : []
// Archivierte Einheit: KT1 sieht den Hinweis und — falls gesetzt — den Link zur Nachfolgerin.
const archiviert = role === 'kt1' && isArchiviert(meta)
const nachfolgerin = archiviert && meta.ersetzt_durch ? einheitById(meta.ersetzt_durch) : undefined

// SSR: Kompetenz-Klartexte verbatim aus dem nRLP auflösen, bevor das Set ins
// (client:only) Renderer-Island serialisiert wird — so bleibt der nRLP-Datensatz
// aus dem Client-Bundle und Preview wie ZIP-Download zeigen die Kompetenzen.
const renderSet = enrichKompetenzen(visibleSet)

// B3 — Abdeckungs-Übersicht aus dem Index (keine zusätzlichen Datenquellen nötig).
const abgedeckte = meta.abgedeckte_kompetenzen?.length ? meta.abgedeckte_kompetenzen : [meta.kompetenz_nr]
const letters = ['A', 'B', 'C'] as const

// Kompetenz-Klartexte (verbatim aus dem nRLP) — bewusst NUR hier auf der Detailseite
// ausgeschrieben, nicht im Katalog. Die Texte liegen bereits enrichKompetenzen-aufgelöst
// in renderSet.hf_*.nrlp.kompetenzen; wir bauen daraus eine {nr → text}-Map.
const kompTextMap = new Map<string, string>()
for (const hf of [renderSet.hf_A, renderSet.hf_B, renderSet.hf_C]) {
  for (const k of hf?.nrlp?.kompetenzen ?? []) {
    if (k?.nr && k?.text && !kompTextMap.has(String(k.nr))) kompTextMap.set(String(k.nr), k.text)
  }
}
const kompTexte = abgedeckte.map((nr) => ({ nr, text: kompTextMap.get(String(nr)) || '' }))

// Rückmeldungen anderer Lehrpersonen, ohne Namen (nicht für das geteilte Gastkonto).
const erfahrungen = isGuest ? null : await ladeErfahrungen(setKey)
---
<Einheiten title={meta.einheit_titel} role={role} fullBleed>
  <style is:global set:html={cssRenderer}></style>

  {/* «Zuletzt geöffnet» im Katalog: nur dieses Gerät, nur die Einheiten-ID. */}
  <script is:inline define:vars={{ setKey }}>
    try {
      const k = 'hko.katalog.zuletzt'
      const alt = JSON.parse(localStorage.getItem(k) || '[]').filter((x) => typeof x === 'string' && x !== setKey)
      localStorage.setItem(k, JSON.stringify([setKey, ...alt].slice(0, 4)))
    } catch {}
  </script>

  {archiviert && (
    <div class="bg-slate-100 border-b border-slate-300">
      <div class="max-w-7xl mx-auto px-6 py-2.5 flex flex-wrap items-center gap-2 text-sm text-slate-700">
        <span class="font-semibold">Archiviert — nur für KT1 sichtbar.</span>
        <span>Diese Einheit ist abgelöst. Lehrpersonen sehen sie nicht; die QR-Seite der gedruckten Hefte funktioniert weiter.</span>
        {nachfolgerin && (
          <a href={`/einheiten/${nachfolgerin.id}`} class="ml-auto font-medium underline text-slate-900">Ersetzt durch: {nachfolgerin.einheit_titel} →</a>
        )}
      </div>
    </div>
  )}

  {role === 'kt1' && (isEntwurf(meta) || draftKomps.length > 0) && (
    <div class="bg-amber-50 border-b border-amber-200">
      <div class="max-w-7xl mx-auto px-6 py-2.5 flex flex-wrap items-center gap-2 text-sm text-amber-900">
        <span class="font-semibold">● Entwurf — nur für KT1 sichtbar.</span>
        {isEntwurf(meta)
          ? <span>Diese ganze Einheit ist noch nicht publiziert. Lehrpersonen sehen sie nicht.</span>
          : <span>Live für alle, ausser: {draftKomps.map((k) => KOMPONENTEN_LABEL[k] ?? k).join(', ')} (sehen nur KT1).</span>}
        <span class="ml-auto text-xs text-amber-700">Publizieren: Flag in <code>set.json</code> entfernen → <code>npm run build:einheiten-index</code> → deploy.</span>
      </div>
    </div>
  )}

  <div class="border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-wrap items-baseline gap-3">
      <a href="/einheiten" class="text-sm text-slate-500 hover:text-slate-700">← Katalog</a>
      <span class="text-slate-300">·</span>
      <h1 class="text-lg font-semibold text-slate-900">{meta.einheit_titel}</h1>
      <span class="text-sm text-slate-500">{meta.titel}</span>{zeigeUmschalter && (
        <nav class="inline-flex gap-1 text-sm" aria-label="Ansicht der Einheit" style="border: 1px solid var(--brand); border-radius: 9999px; padding: 2px;">
          {(['original', 'fassung'] as const).map((a) => {
            const aktiv = a === 'original' ? forkProp?.modus === 'original' : forkProp?.modus !== 'original'
            return (
              <a href={forkUrl(a)} aria-current={aktiv ? 'page' : undefined}
                style={`padding: 2px 12px; border-radius: 9999px; color: var(--brand-dark); ${aktiv ? 'background: var(--brand-tint); font-weight: 600;' : ''}`}>
                {a === 'original' ? 'Original' : 'Meine Fassung'}
              </a>
            )
          })}
        </nav>
      )}
      <div class="ml-auto flex items-center gap-2 text-xs text-slate-500">
        {meta.hat_spuren && <a href="/einheiten/neues-format" class="underline hover:text-slate-700">Neues Format — was ist anders?</a>}
        {lehrgaengeOf(meta).map((l) => <span class="chip chip-blue">{lehrgangLabel(l)}</span>)}
        {meta.thema_nr != null && <span class="chip">T{meta.thema_nr}</span>}
        {meta.aspekte.slice(0, 2).map((a) => <span class="chip chip-green">{a}</span>)}
      </div>
    </div>{forkAnsicht && (
      <div style="background: var(--brand-tint); border-bottom: 1px solid var(--brand); color: var(--brand-dark);">
        <div class="max-w-7xl mx-auto px-6 py-2.5 text-sm">
          <p class="font-semibold">
            {forkAnsicht.modus === 'vorschau'
              ? 'Vorschau: Ihre Fassung mit dem neuen Vorschlag. Noch nichts ist übernommen.'
              : 'Meine Fassung — angepasst, nicht von KT1 geprüft.'}
            {forkAnsicht.modus === 'vorschau' && <a href={forkUrl('fassung')} class="ml-2 font-normal underline">Vorschau schliessen</a>}
          </p>
          {(forkAnsicht.warnungen.length > 0 || (forkAnsicht.bericht?.veraltet.length ?? 0) > 0) && (
            <ul class="mt-1 list-disc pl-5 space-y-0.5">
              {forkAnsicht.warnungen.map((w) => <li>{w.text}</li>)}
              {(forkAnsicht.bericht?.veraltet.length ?? 0) > 0 && (
                <li>{forkAnsicht.bericht!.veraltet.length} Anpassungen gelten nicht mehr, weil sich das Original geändert hat.</li>
              )}
            </ul>
          )}
        </div>
      </div>
    )}
  </div>

  <!-- B3 — «Was deckt diese Einheit ab?» (additive Übersicht aus dem Index) -->
  <div class="border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-6 py-5">
      <h2 class="text-sm font-semibold text-slate-900 mb-3">Was deckt diese Einheit ab?</h2>
      <div class="mb-5">
        <span class="block text-[11px] uppercase tracking-wider text-slate-400 mb-2">Kompetenzen</span>
        <ul class="space-y-2">
          {kompTexte.map((k) => (
            <li class="flex gap-2.5 items-start">
              <span class="chip chip-blue shrink-0 mt-0.5">Kompetenz {k.nr}</span>
              {k.text && <span class="text-sm text-slate-700 leading-snug">{k.text}</span>}
            </li>
          ))}
        </ul>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-4">
        {meta.aspekte.length > 0 && (
          <div>
            <span class="block text-[11px] uppercase tracking-wider text-slate-400 mb-1.5">Gesellschafts-Aspekte</span>
            <div class="flex flex-wrap gap-1.5">
              {meta.aspekte.map((a) => <span class="chip chip-green">{a}</span>)}
            </div>
          </div>
        )}
        {meta.sprachmodi.length > 0 && (
          <div>
            <span class="block text-[11px] uppercase tracking-wider text-slate-400 mb-1.5">Sprachmodi</span>
            <div class="flex flex-wrap gap-1.5">
              {meta.sprachmodi.map((s) => <span class="chip">{s}</span>)}
            </div>
          </div>
        )}
        {meta.sk.length > 0 && (
          <div>
            <span class="block text-[11px] uppercase tracking-wider text-slate-400 mb-1.5">Schlüsselkompetenzen</span>
            <div class="flex flex-wrap gap-1.5">
              {meta.sk.map((n) => <span class="chip" title={skTooltip(skNameByNr(n))}>SK {n} · {skNameByNr(n)}</span>)}
            </div>
          </div>
        )}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 mt-4 pt-4 border-t border-slate-100">
        <div>
          <span class="block text-[11px] uppercase tracking-wider text-slate-400 mb-1.5">3 Herausforderungen</span>
          <ol class="text-sm text-slate-600 space-y-1">
            {letters.map((l) => meta.hf_titel[l] && (
              <li><span class="font-medium text-slate-800">{l}</span> · {meta.hf_titel[l]}</li>
            ))}
          </ol>
        </div>
        {meta.kn_typen.length > 0 && (
          <div>
            <span class="block text-[11px] uppercase tracking-wider text-slate-400 mb-1.5">Kompetenznachweis — verfügbare Typen</span>
            <div class="flex flex-wrap gap-1.5">
              {meta.kn_typen.map((t) => <span class="chip">{knTypLabel(t.typ, t.label)}</span>)}
            </div>
          </div>
        )}
      </div>

      <p class="text-xs text-slate-400 mt-4">Richtwert: ca. 3–7 Lektionen + Kompetenznachweis. Didaktische Details im Begleitdokument.</p>
    </div>
  </div>

  {erfahrungen && <Erfahrungen daten={erfahrungen} feedbackUrl={`/einheiten/${setKey}/feedback`} />}

  <EinheitWorkbench
    client:only="react"
    set={renderSet}
    cssRenderer={cssRenderer}
    cssBegleiter={cssBegleiter}
    logoUrl="/logo-bbw-doc.png"
    feedbackUrl={`/einheiten/${setKey}/feedback`}
    abgedeckteKompetenzen={meta.abgedeckte_kompetenzen}
    defaultAbteilung={defaultAbteilung}
    readOnly={isGuest}
    {...(forkProp ? { fork: forkProp } : {})}
  />
</Einheiten>

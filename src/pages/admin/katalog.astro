---
// DUMMY — Vorschlag für einen skalierbaren Einheiten-Katalog (KT1-only, noch nicht live).
// Zeigt die echten Einheiten aus dem Index PLUS erfundene T2-Platzhalter, damit sichtbar
// wird, wie die Seite aussieht, wenn die nächsten zwei Wochen T2 dazukommen.
// Nichts hier schreibt etwas; /einheiten bleibt unverändert.
import Admin from '../../layouts/Admin.astro'
import { einheitenIndex, lehrgaengeOf, lehrgangShort } from '../../lib/einheiten'
import { THEMA_COLORS } from '../../lib/thema-colors'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')

const { data: profile } = await Astro.locals.supabase
  .from('profiles')
  .select('role')
  .eq('id', user.id)
  .single()

if (profile?.role !== 'kt1') return Astro.redirect('/')

const NEU = new Set(['1.3.1_konsum_verantworten', '1.2.2_ki_kompetenznachweis_vorbereiten'])

const echt = einheitenIndex.map((e: any) => ({
  id: e.id,
  dummy: false,
  titel: e.einheit_titel,
  kompetenz: e.kompetenz_nr,
  modul: e.modul,
  modul_titel: e.modul_titel,
  thema: e.thema_nr ?? 0,
  lehrgaenge: lehrgaengeOf(e),
  entwurf: e.status === 'entwurf',
  neu: NEU.has(e.id),
  hf: e.herausforderungen?.length ?? 0,
  kn: !!e.hat_kn,
  ki: !!e.hat_ki,
  methoden: !!e.hat_methoden,
  href: `/einheiten/${e.id}`,
}))

// Erfundene Platzhalter für T2 — nur zur Anschauung.
const t2 = (
  [
    ['2.1.1', '2.1', 'Informationen einordnen', 'Nachrichten prüfen, bevor ich sie teile', ['EFZ_3J', 'EFZ_4J'], 3, true, false],
    ['2.1.2', '2.1', 'Informationen einordnen', 'Desinformation erkennen', ['EFZ_3J', 'EFZ_4J'], 3, true, true],
    ['2.1.2', '2.1', 'Informationen einordnen', 'Was ist wahr? (EBA)', ['EBA_2J'], 2, true, false],
    ['2.2.1', '2.2', 'Meinungen vertreten', 'Meine Haltung begründen', ['EFZ_3J'], 3, true, false],
    ['2.2.2', '2.2', 'Meinungen vertreten', 'In der Diskussion bestehen', ['EFZ_4J'], 3, true, false],
    ['2.2.2', '2.2', 'Meinungen vertreten', 'Meine Meinung sagen (EBA)', ['EBA_2J'], 2, true, false],
    ['2.3.1', '2.3', 'Mitgestalten', 'Abstimmen und wählen', ['EFZ_3J', 'EFZ_4J'], 3, true, true],
    ['2.3.2', '2.3', 'Mitgestalten', 'Eine Petition starten', ['EFZ_4J'], 3, true, false],
    ['2.3.2', '2.3', 'Mitgestalten', 'Mitreden im Betrieb', ['EFZ_3J'], 3, false, false],
    ['2.3.3', '2.3', 'Mitgestalten', 'Mitbestimmen in der Gemeinde (EBA)', ['EBA_2J'], 2, true, false],
  ] as const
).map(([k, m, mt, titel, lg, hf, kn, ki], i) => ({
  id: `dummy-t2-${i}`,
  dummy: true,
  titel,
  kompetenz: k,
  modul: m,
  modul_titel: mt,
  thema: 2,
  lehrgaenge: [...lg],
  entwurf: i > 6,
  neu: false,
  hf,
  kn,
  ki,
  methoden: i % 3 === 0,
  href: '',
}))

const alle = [...echt, ...t2]
const themen = Object.values(THEMA_COLORS).map((t) => ({ nr: t.nr, titel: t.titel }))
const lehrgangKurz = Object.fromEntries(
  ['EBA_2J', 'EFZ_3J', 'EFZ_4J'].map((l) => [l, lehrgangShort(l)]),
)
---

<Admin title="Katalog-Vorschlag (Dummy)">
  <main class="max-w-7xl mx-auto px-6 py-6 w-full" x-data="katalog()" x-cloak>
    <div class="rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm mb-5">
      <strong>Dummy-Vorschlag.</strong> Die ersten Einheiten sind echt, die mit «Platzhalter» markierten T2-Einheiten sind
      erfunden und zeigen nur, wie die Seite mit mehr Inhalt aussieht. Der echte Katalog unter
      <a href="/einheiten" class="underline">/einheiten</a> ist unverändert.
    </div>

    <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
      <div>
        <h1 class="text-2xl font-semibold">Unterrichtseinheiten</h1>
        <p class="text-sm text-slate-500 mt-1">
          <span x-text="treffer"></span> von <span x-text="alle.length"></span> Einheiten
        </p>
      </div>
      <div class="inline-flex rounded-md border border-slate-300 overflow-hidden text-sm" role="group" aria-label="Ansicht">
        <button type="button" class="px-3 py-1.5" :class="ansicht === 'liste' ? 'bg-slate-900 text-white' : 'bg-white'" @click="ansicht = 'liste'">Liste</button>
        <button type="button" class="px-3 py-1.5 border-l border-slate-300" :class="ansicht === 'karten' ? 'bg-slate-900 text-white' : 'bg-white'" @click="ansicht = 'karten'">Karten</button>
      </div>
    </div>

    <!-- Filterleiste: bleibt beim Scrollen sichtbar -->
    <div class="sticky top-[88px] z-10 bg-white border border-slate-200 rounded-lg p-3 mb-6 shadow-sm space-y-3">
      <div class="flex flex-wrap gap-3 items-center">
        <input type="search" x-model="q" placeholder="Suche nach Titel oder Kompetenz …" class="input" style="min-width:16rem" />
        <div class="inline-flex rounded-md border border-slate-300 overflow-hidden text-sm" role="group" aria-label="Lehrgang">
          <template x-for="l in lehrgangOptionen" :key="l.v">
            <button type="button" class="px-3 py-1.5 border-r border-slate-300 last:border-r-0" :class="lehrgang === l.v ? 'bg-slate-900 text-white' : 'bg-white'" @click="lehrgang = l.v" x-text="l.t"></button>
          </template>
        </div>
        <label class="text-sm flex items-center gap-1.5"><input type="checkbox" x-model="nurKi" /> mit KI-Toolbox</label>
        <label class="text-sm flex items-center gap-1.5"><input type="checkbox" x-model="nurMethoden" /> mit Methoden-Karten</label>
        <label class="text-sm flex items-center gap-1.5"><input type="checkbox" x-model="nurNeu" /> nur neu</label>
        <button type="button" class="text-sm text-slate-500 underline ml-auto" @click="reset()">Zurücksetzen</button>
      </div>
      <div class="flex flex-wrap gap-1.5">
        <button type="button" class="px-2.5 py-1 rounded-full text-xs font-medium border" :class="thema === 0 ? 'bg-slate-900 text-white border-slate-900' : 'bg-white border-slate-300'" @click="thema = 0">Alle Themen</button>
        <template x-for="t in themen" :key="t.nr">
          <button
            type="button"
            class="thema-chip"
            :data-thema="t.nr"
            :style="'cursor:pointer;opacity:' + (zaehlerThema(t.nr) === 0 ? .35 : 1) + ';outline:' + (thema === t.nr ? '2px solid #0f172a' : 'none') + ';outline-offset:2px'"
            :disabled="zaehlerThema(t.nr) === 0"
            :title="t.titel"
            @click="thema = (thema === t.nr ? 0 : t.nr)"
          >T<span x-text="t.nr"></span> · <span x-text="zaehlerThema(t.nr)"></span></button>
        </template>
      </div>
    </div>

    <p x-show="treffer === 0" class="bg-white border border-slate-200 rounded-lg p-8 text-center text-slate-500 text-sm">
      Keine Einheit passt zu diesen Filtern.
    </p>

    <!-- Gruppen: Thema → Lebensbezug -->
    <template x-for="g in gruppen" :key="g.thema">
      <section class="mb-5" :data-thema="g.thema">
        <button
          type="button"
          class="thema-fill w-full flex items-center gap-3 rounded-lg px-4 py-2.5 text-left"
          :aria-expanded="offen(g.thema)"
          @click="toggle(g.thema)"
        >
          <span class="font-semibold">T<span x-text="g.thema"></span> · <span x-text="titelThema(g.thema)"></span></span>
          <span class="text-xs opacity-80" x-text="g.anzahl + (g.anzahl === 1 ? ' Einheit' : ' Einheiten')"></span>
          <span class="ml-auto text-lg leading-none" x-text="offen(g.thema) ? '−' : '+'"></span>
        </button>

        <div x-show="offen(g.thema)" x-collapse class="pt-3 pl-1 md:pl-3">
          <template x-for="m in g.module" :key="m.modul">
            <div class="mb-4">
              <h3 class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-1.5">
                <span x-text="m.modul"></span> · <span x-text="m.modul_titel"></span>
              </h3>

              <!-- Liste -->
              <div x-show="ansicht === 'liste'" class="bg-white border border-slate-200 rounded-lg divide-y divide-slate-100">
                <template x-for="e in m.items" :key="e.id">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-2 text-sm">
                    <span class="chip chip-blue shrink-0" x-text="e.kompetenz"></span>
                    <a x-show="!e.dummy" :href="e.href" class="font-medium text-slate-900 hover:underline flex-1 min-w-[12rem]" x-text="e.titel"></a>
                    <span x-show="e.dummy" class="font-medium text-slate-500 flex-1 min-w-[12rem]"><span x-text="e.titel"></span> <em class="text-[11px] not-italic px-1.5 py-0.5 rounded bg-slate-100 text-slate-500">Platzhalter</em></span>
                    <span class="flex gap-1 shrink-0">
                      <template x-for="l in e.lehrgaenge" :key="l"><span class="chip" x-text="lehrgangKurz[l]"></span></template>
                    </span>
                    <span class="flex gap-1 shrink-0 text-[11px] text-slate-500">
                      <span x-text="e.hf + ' HF'"></span>
                      <span x-show="e.kn">· KN</span>
                      <span x-show="e.ki">· KI</span>
                      <span x-show="e.methoden">· Methoden</span>
                    </span>
                    <span x-show="e.neu" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">Neu</span>
                    <span x-show="e.entwurf" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200">Entwurf</span>
                  </div>
                </template>
              </div>

              <!-- Karten -->
              <div x-show="ansicht === 'karten'" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                <template x-for="e in m.items" :key="e.id">
                  <div class="bg-white border border-slate-200 rounded-lg p-4 thema-top" :data-thema="e.thema">
                    <div class="flex flex-wrap gap-1.5 mb-1.5">
                      <span class="chip chip-blue" x-text="e.kompetenz"></span>
                      <template x-for="l in e.lehrgaenge" :key="l"><span class="chip" x-text="lehrgangKurz[l]"></span></template>
                      <span x-show="e.neu" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">Neu</span>
                      <span x-show="e.entwurf" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">Entwurf</span>
                    </div>
                    <a x-show="!e.dummy" :href="e.href" class="font-semibold text-slate-900 leading-snug hover:underline block" x-text="e.titel"></a>
                    <p x-show="e.dummy" class="font-semibold text-slate-500 leading-snug"><span x-text="e.titel"></span> · Platzhalter</p>
                    <p class="text-[11px] text-slate-500 mt-2">
                      <span x-text="e.hf + ' Herausforderungen'"></span>
                      <span x-show="e.kn"> · KN</span><span x-show="e.ki"> · KI-Toolbox</span><span x-show="e.methoden"> · Methoden-Karten</span>
                    </p>
                  </div>
                </template>
              </div>
            </div>
          </template>
        </div>
      </section>
    </template>
  </main>

  <script is:inline define:vars={{ alle, themen, lehrgangKurz }}>
    document.addEventListener('alpine:init', () => {
      Alpine.data('katalog', () => ({
        alle, themen, lehrgangKurz,
        q: '', lehrgang: '', thema: 0,
        nurKi: false, nurMethoden: false, nurNeu: false,
        ansicht: 'liste',
        zu: {},
        lehrgangOptionen: [
          { v: '', t: 'Alle' },
          { v: 'EBA_2J', t: 'EBA' },
          { v: 'EFZ_3J', t: 'EFZ 3J' },
          { v: 'EFZ_4J', t: 'EFZ 4J' },
        ],
        passt(e, ohneThema) {
          const q = this.q.trim().toLowerCase()
          if (q && !(e.titel + ' ' + e.kompetenz + ' ' + e.modul_titel).toLowerCase().includes(q)) return false
          if (this.lehrgang && !e.lehrgaenge.includes(this.lehrgang)) return false
          if (this.nurKi && !e.ki) return false
          if (this.nurMethoden && !e.methoden) return false
          if (this.nurNeu && !e.neu) return false
          if (!ohneThema && this.thema && e.thema !== this.thema) return false
          return true
        },
        get gefiltert() { return this.alle.filter((e) => this.passt(e)) },
        get treffer() { return this.gefiltert.length },
        zaehlerThema(nr) { return this.alle.filter((e) => e.thema === nr && this.passt(e, true)).length },
        titelThema(nr) { return (this.themen.find((t) => t.nr === nr) || {}).titel || '' },
        get gruppen() {
          const out = []
          for (const e of this.gefiltert) {
            let g = out.find((x) => x.thema === e.thema)
            if (!g) { g = { thema: e.thema, anzahl: 0, module: [] }; out.push(g) }
            g.anzahl++
            let m = g.module.find((x) => x.modul === e.modul)
            if (!m) { m = { modul: e.modul, modul_titel: e.modul_titel, items: [] }; g.module.push(m) }
            m.items.push(e)
          }
          out.sort((a, b) => a.thema - b.thema)
          out.forEach((g) => g.module.sort((a, b) => a.modul.localeCompare(b.modul, 'de', { numeric: true })))
          return out
        },
        // Standard: ein einzelnes Thema ist offen, sobald gefiltert wird sind alle Treffer offen.
        gefiltertAktiv() { return !!(this.q || this.lehrgang || this.thema || this.nurKi || this.nurMethoden || this.nurNeu) },
        offen(nr) {
          if (nr in this.zu) return !this.zu[nr]
          return this.gefiltertAktiv() || nr === 1
        },
        toggle(nr) { this.zu[nr] = this.offen(nr) },
        reset() { this.q = ''; this.lehrgang = ''; this.thema = 0; this.nurKi = this.nurMethoden = this.nurNeu = false; this.zu = {} },
      }))
    })
  </script>
</Admin>

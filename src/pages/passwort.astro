---
import Base from '../layouts/Base.astro'

if (!Astro.locals.user) return Astro.redirect('/login')

const { data: profile } = await Astro.locals.supabase
  .from('profiles')
  .select('role')
  .eq('id', Astro.locals.user.id)
  .single()

// The shared guest account has no password of its own to change.
if (profile?.role === 'gast') return Astro.redirect('/')

const zurueck = profile?.role === 'kt1' ? '/admin' : '/'
---
<Base title="Passwort ändern">
  <div class="min-h-screen flex items-center justify-center px-4">
    <div class="w-full max-w-sm bg-white border border-slate-200 rounded-xl p-8 shadow-sm">

      <div class="flex justify-center mb-6">
        <img src="/logo-bbw-mark.png" alt="BBW Berufsbildungsschule Winterthur" class="logo-black h-20 w-auto" />
      </div>
      <h1 class="text-xl font-semibold text-center mb-1">Passwort ändern</h1>
      <p class="text-sm text-slate-500 text-center mb-6">{Astro.locals.user.email}</p>

      <div x-data="{ aktuell: '', neu: '', wiederholung: '', saving: false, error: '', ok: false }">
        <div x-show="ok" class="space-y-4">
          <div class="p-3 bg-green-50 border border-green-200 rounded text-sm text-green-800">Dein Passwort wurde geändert.</div>
          <a href={zurueck} class="block text-center w-full py-2.5 rounded-md text-white font-medium text-sm transition hover:opacity-90" style="background: var(--brand)">Zurück zur Plattform</a>
        </div>

        <form x-show="!ok" class="space-y-4" @submit.prevent="
          error = '';
          if (neu !== wiederholung) { error = 'Die beiden neuen Passwörter stimmen nicht überein.'; return }
          saving = true;
          fetch('/api/auth/passwort', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ aktuell, neu }),
          })
          .then(r => r.ok ? (ok = true, saving = false) : r.json().catch(() => ({})).then(b => { error = b.error || `Fehler beim Speichern (${r.status}).`; saving = false }))
          .catch(() => { error = 'Netzwerkfehler.'; saving = false })
        ">
          <div>
            <label class="field-label" for="aktuell">Bisheriges Passwort</label>
            <input id="aktuell" type="password" autocomplete="current-password" required x-model="aktuell" class="input mt-1" />
          </div>
          <div>
            <label class="field-label" for="neu">Neues Passwort</label>
            <input id="neu" type="password" autocomplete="new-password" required minlength="8" x-model="neu" class="input mt-1" />
            <p class="text-xs text-slate-400 mt-1">Mindestens 8 Zeichen.</p>
          </div>
          <div>
            <label class="field-label" for="wiederholung">Neues Passwort wiederholen</label>
            <input id="wiederholung" type="password" autocomplete="new-password" required minlength="8" x-model="wiederholung" class="input mt-1" />
          </div>

          <div x-show="error" class="p-3 bg-red-50 border border-red-200 rounded text-sm text-red-700" x-text="error"></div>

          <button
            type="submit"
            :disabled="!aktuell || !neu || !wiederholung || saving"
            class="w-full py-2.5 rounded-md text-white font-medium text-sm transition hover:opacity-90 disabled:opacity-50"
            style="background: var(--brand)"
            x-text="saving ? 'Wird gespeichert…' : 'Passwort ändern'"
          ></button>
          <a href={zurueck} class="block text-center text-sm text-slate-500 hover:text-slate-700 underline">Abbrechen</a>
        </form>
      </div>

    </div>
  </div>
</Base>
